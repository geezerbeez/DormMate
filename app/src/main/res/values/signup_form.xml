<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SignUpLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#101010</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SignUpDateLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#201B18</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SignUpInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/rounded_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#201B18</item>
        <item name="android:textColorHint">#796C64</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SignUpDateInput" parent="SignUpInput">
        <item name="android:layout_height">52dp</item>
        <item name="android:inputType">number</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <string-array name="signup_months">
        <item>Month</item>
        <item>January</item>
        <item>February</item>
        <item>March</item>
        <item>April</item>
        <item>May</item>
        <item>June</item>
        <item>July</item>
        <item>August</item>
        <item>September</item>
        <item>October</item>
        <item>November</item>
        <item>December</item>
    </string-array>

</resources>