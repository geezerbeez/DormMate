<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.DormMate" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/orange</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <!-- Primary Button -->
    <style name="Widget.DormMate.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/orange</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">56dp</item>
    </style>

    <!-- Secondary Button -->
    <style name="Widget.DormMate.Button.Secondary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/transparent</item>
        <item name="android:textColor">@color/orange</item>
        <item name="cornerRadius">56dp</item>
    </style>

    <!-- Circle frame for profile picture -->
    <style name="circleImage" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.DormMate" parent="Base.Theme.DormMate" />

    <!-- Bottom Navigation Bar -->
    <style name="Widget.DormMate.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">

        <item name="android:color">@color/nav_indicator</item>
        <item name="shapeAppearance">
            @style/ShapeAppearance.DormMate.BottomNav
        </item>

    </style>

    <style name="ShapeAppearance.DormMate.BottomNav" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <!-- EDIT PROFILE SCREEN -->

    <array name="budget_initial_values">
        <item>6000.0</item>
        <item>10000.0</item>
    </array>

    <!-- Lifestyle habit chips (soft green, with check icon when selected) -->
    <style name="Widget.DormMate.Chip.Lifestyle" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">#DCEFE6</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconTint">#2F7D5B</item>
        <item name="android:textColor">#2F7D5B</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Roommate preference chips (turn dark when selected) -->
    <style name="Widget.DormMate.Chip.Roommate" parent="Widget.Material3.Chip.Filter">
        <item name="materialThemeOverlay">@style/ThemeOverlay.DormMate.RoommateChip</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Material 3 colors a selected filter chip with colorSecondaryContainer -->
    <style name="ThemeOverlay.DormMate.RoommateChip" parent="">
        <item name="colorSecondaryContainer">#1F2A30</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
    </style>
</resources>