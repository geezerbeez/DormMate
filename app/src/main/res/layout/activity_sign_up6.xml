<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignUp6"
    android:background="@color/cream">

    <View
        android:layout_width="wrap_content"
        android:layout_height="590dp"
        android:layout_gravity="end"
        android:layout_marginTop="200dp"
        android:background="@drawable/continue_shape_signup" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Be Kind To\n    Others"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:layout_gravity="center_horizontal"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/orange"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="530dp"
        android:layout_marginTop="200dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"

        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="message about not tolerating\nbullying, etc. just like in other\ndating apps"
            android:textAlignment="center"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnAcceptSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:layout_marginTop="350dp"
            android:text="I accept"
            android:textSize="15sp"
            android:paddingStart="100dp"
            android:paddingEnd="100dp"
            android:backgroundTint="@color/black"/>
    </LinearLayout>

</FrameLayout>