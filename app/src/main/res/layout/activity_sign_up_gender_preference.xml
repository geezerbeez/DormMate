<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity_sign_up_genderPreference"
    android:background="@color/cream">
    <View
        android:layout_width="288dp"
        android:layout_height="496dp"
        android:layout_marginStart="150dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/bg_deco"
        android:layout_marginRight="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="30dp"
        >

        <TextView
            android:layout_width="379dp"
            android:layout_height="wrap_content"
            android:text="Who would you prefer to live with?"
            android:textColor="@color/black"
            android:textSize="50sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="227dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Select your preferred roommate gender."
            android:textSize="20sp" />

        <FrameLayout
            android:id="@+id/btnMale"
            android:layout_width="365dp"
            android:layout_height="78dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_button_outline"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:clickable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:text="Male"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/shpSolid1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="260dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/circle_outline" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnFemale"
            android:layout_width="365dp"
            android:layout_height="78dp"
            android:background="@drawable/rounded_button_outline"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:layout_marginTop="20dp"
            android:clickable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:text="Female"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/shpSolid2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="240dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/circle_outline" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:clickable="true"
            android:id="@+id/btnNoPref"
            android:layout_width="365dp"
            android:layout_height="78dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_button_outline"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="209dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:text="No Preference"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/shpSolid3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="90dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/circle_outline" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvGenderWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="*Please select a roommate gender preference"
            android:paddingTop="10dp"
            android:textColor="@color/orange"
            android:visibility="gone"/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnProceedPref"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/circle_button"
        android:backgroundTint="#000000"
        android:src="@drawable/ic_continue"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:contentDescription="Continue" />

</FrameLayout>