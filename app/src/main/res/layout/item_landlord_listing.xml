<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="96dp"
                android:layout_height="96dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/listingPhotoIv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Listing photo"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/dorm_photo_1" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/listingStatusTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:background="@drawable/bg_status_active"
                    tools:text="Active"
                    tools:textColor="@color/statusGreen" />

                <TextView
                    android:id="@+id/listingNameTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Casa Verde Dormitory" />

                <TextView
                    android:id="@+id/listingPriceTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/orange"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="₱4,200 / month" />

                <TextView
                    android:id="@+id/listingMetaTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/inkSoft"
                    android:textSize="12sp"
                    tools:text="Bedspace · 3 of 8 slots open · 12 inquiries" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/editBtn"
                style="@style/Widget.DormMate.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Edit"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:icon="@drawable/ic_edit"
                app:iconPadding="2dp"
                app:iconSize="16dp"
                app:iconTint="@color/orange"
                app:strokeColor="@color/orange"
                app:strokeWidth="1.5dp" />

            <Button
                android:id="@+id/visibilityBtn"
                style="@style/Widget.DormMate.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Hide"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:icon="@drawable/ic_visibility_off"
                app:iconPadding="2dp"
                app:iconSize="16dp"
                app:iconTint="@color/orange"
                app:strokeColor="@color/orange"
                app:strokeWidth="1.5dp" />

            <Button
                android:id="@+id/fullBtn"
                style="@style/Widget.DormMate.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Mark full"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:strokeColor="@color/orange"
                app:strokeWidth="1.5dp" />

            <ImageButton
                android:id="@+id/deleteBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill"
                android:contentDescription="Delete listing"
                android:src="@drawable/ic_delete"
                app:tint="@color/statusOrange" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
