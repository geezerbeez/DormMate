<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    tools:context=".SignUp2">

    <View
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_gravity="bottom"
        android:background="@drawable/signup_wave"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="12dp"
                android:src="@drawable/signup_back" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Your details"
                android:textColor="#101010"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Let’s start with the basics."
                android:textColor="#634835"
                android:textSize="18sp" />

            <TextView
                style="@style/SignUpLabel"
                android:layout_marginTop="32dp"
                android:labelFor="@+id/etFirstName"
                android:text="First name" />

            <EditText
                android:id="@id/etFirstName"
                style="@style/SignUpInput"
                android:autofillHints="personGivenName"
                android:hint="Enter your first name"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/SignUpLabel"
                android:layout_marginTop="18dp"
                android:labelFor="@+id/etLastName"
                android:text="Last name" />

            <EditText
                android:id="@id/etLastName"
                style="@style/SignUpInput"
                android:autofillHints="personFamilyName"
                android:hint="Enter your last name"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/SignUpLabel"
                android:layout_marginTop="28dp"
                android:text="Date of birth" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Month gets more width than day and year -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SignUpDateLabel"
                        android:labelFor="@+id/spMonth"
                        android:text="Month" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/rounded_input">

                        <Spinner
                            android:id="@id/spMonth"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:entries="@array/signup_months"
                            android:spinnerMode="dropdown" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SignUpDateLabel"
                        android:labelFor="@+id/etDay"
                        android:text="Day" />

                    <EditText
                        android:id="@id/etDay"
                        style="@style/SignUpDateInput"
                        android:hint="DD"
                        android:imeOptions="actionNext"
                        android:maxLength="2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SignUpDateLabel"
                        android:labelFor="@+id/etYear"
                        android:text="Year" />

                    <EditText
                        android:id="@id/etYear"
                        style="@style/SignUpDateInput"
                        android:hint="YYYY"
                        android:imeOptions="actionDone"
                        android:maxLength="4" />
                </LinearLayout>
            </LinearLayout>

            <!-- Takes up extra room on tall screens -->
            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <android.widget.Button
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/signup_continue"
                android:backgroundTint="@null"
                android:text="Continue  →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>