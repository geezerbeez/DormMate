<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignUp5"
    android:background="@color/cream">

    <View
        android:layout_width="288dp"
        android:layout_height="496dp"
        android:layout_gravity="end"
        android:layout_marginTop="100dp"
        android:background="@drawable/bg_deco" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="100dp"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="40dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What about\nyour lifestyle\nand habits"
                android:textSize="45sp"
                android:textStyle="bold"
                android:textColor="#100f0d"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share as much as you’re\ncomfortable with."
                android:textSize="15sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drinking"
                android:layout_marginTop="20dp"
                android:textSize="20sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDrinkingCh1"
                    style="@style/InterestOption"
                    android:drawableEnd="@drawable/ic_interest_add"
                    android:text="Yes" />

                <TextView
                    android:id="@+id/btnDrinkingCh2"
                    style="@style/InterestOption"
                    android:layout_marginStart="16dp"
                    android:drawableEnd="@drawable/ic_interest_add"
                    android:text="Sometimes" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDrinkingCh3"
                    style="@style/InterestOption"
                    android:drawableEnd="@drawable/ic_interest_add"
                    android:text="Trying to quit" />

                <TextView
                    android:id="@+id/btnDrinkingCh4"
                    style="@style/InterestOption"
                    android:layout_marginStart="16dp"
                    android:drawableEnd="@drawable/ic_interest_add"
                    android:text="No" />

            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smoking"
                android:layout_marginTop="20dp"
                android:textSize="20sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSmokingCh1"
                    style="@style/InterestOption"
                    android:drawableEnd="@drawable/ic_interest_add"
                    android:text="Yes" />

                <TextView
                    android:id="@+id/btnSmokingCh2"
                    style="@style/InterestOption"
                    android:layout_marginStart="16dp"
                    android:drawableEnd="@drawable/ic_interest_add"
                    android:text="Sometimes" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDSmokingCh3"
                    style="@style/InterestOption"
                    android:drawableEnd="@drawable/ic_interest_add"
                    android:text="Trying to quit" />

                <TextView
                    android:id="@+id/btnSmokingCh4"
                    style="@style/InterestOption"
                    android:layout_marginStart="16dp"
                    android:drawableEnd="@drawable/ic_interest_add"
                    android:text="No" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
    <TextView
        android:id="@+id/tvLifestyleError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="*Select atleast one answer"
        android:layout_gravity="bottom"
        android:layout_marginBottom="90dp"
        android:layout_marginLeft="20dp"
        android:textColor="@color/orange"
        android:visibility="gone"/>
    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="24dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="Skip"
        android:textColor="@color/black"
        android:textSize="24sp" />

    <ImageButton
        android:id="@+id/btnContinue"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/circle_button"
        android:backgroundTint="@color/black"
        android:contentDescription="Continue"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_continue"
        android:tint="@android:color/white" />

</FrameLayout>