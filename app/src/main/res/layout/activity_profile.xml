<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:padding="14dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingTop="28dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/backButtonIb"
            android:layout_width="30dp"
            android:layout_height="30dp"

            tools:src="@drawable/baseline_arrow_back_ios_new_24"

            app:layout_constraintEnd_toStartOf="@+id/profileTitleTv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"/>

        <TextView
            android:id="@+id/profileTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Profile"
            android:textSize="24sp"
            android:textStyle="bold"

            app:layout_constraintStart_toEndOf="@+id/backButtonIb"
            app:layout_constraintEnd_toStartOf="@+id/editButtonIb"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/editButtonIb"
            android:layout_width="30dp"
            android:layout_height="30dp"

            tools:src="@drawable/baseline_edit_24"

            app:layout_constraintStart_toEndOf="@+id/profileTitleTv"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profileHeader"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:paddingTop="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"

        app:layout_constraintTop_toBottomOf="@+id/topHeader">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profilePicture"
            android:layout_width="85dp"
            android:layout_height="80dp"
            app:shapeAppearanceOverlay="@style/circleImage"

            tools:src="@drawable/catpfp"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profilePictureEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            tools:src="@drawable/baseline_photo_camera_24"

            app:layout_constraintBottom_toBottomOf="@+id/profilePicture"
            app:layout_constraintEnd_toEndOf="@+id/profilePicture"/>

        <TextView
            android:id="@+id/nameTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"

            tools:text="User Name"
            android:textStyle="bold"
            android:textSize="26sp"

            app:layout_constraintStart_toEndOf="@+id/profilePicture"/>

        <TextView
            android:id="@+id/profileProgressTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"

            tools:text="Profile 85% completed"

            app:layout_constraintTop_toBottomOf="@+id/nameTv"
            app:layout_constraintStart_toEndOf="@+id/profilePicture"/>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/profileProgressBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"

            tools:progress="85"

            app:layout_constraintStart_toEndOf="@+id/profilePicture"
            app:layout_constraintTop_toBottomOf="@+id/profileProgressTv"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="400dp"

        app:layout_constraintTop_toBottomOf="@+id/profileHeader">


    </androidx.constraintlayout.widget.ConstraintLayout>




</androidx.constraintlayout.widget.ConstraintLayout>