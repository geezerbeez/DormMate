<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical"
    tools:context=".ExploreFragment">

    <!-- Title -->
    <TextView
        android:id="@+id/exploreTitleTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:text="Find your place"
        android:textColor="@color/ink"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="Dorms, condos, and bedspaces near your campus"
        android:textColor="@color/inkSoft"
        android:textSize="14sp" />

    <!-- Search + filter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/inkSoft" />

            <EditText
                android:id="@+id/searchEtv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Search a dorm, area, or university"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textColorHint="@color/inkSoft"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp">

            <ImageButton
                android:id="@+id/filterBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_filter_btn"
                android:contentDescription="Filter dormitories"
                android:src="@drawable/ic_dorm_filter"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/filterBadgeTv"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_circle_white"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/orange"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Quick room-type chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/typeChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.DormMate.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSolo"
                style="@style/Widget.DormMate.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipShared"
                style="@style/Widget.DormMate.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shared" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBedspace"
                style="@style/Widget.DormMate.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bedspace" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Result count + List/Map toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/resultCountTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="6 listings" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/viewToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/listViewBtn"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="List"
                android:textColor="@color/orange"
                app:icon="@drawable/ic_list"
                app:iconTint="@color/orange"
                app:strokeColor="@color/orange" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mapViewBtn"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Map"
                android:textColor="@color/orange"
                app:icon="@drawable/ic_map"
                app:iconTint="@color/orange"
                app:strokeColor="@color/orange" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <!-- Content: list / map / empty -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dormRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp" />

        <!-- Placeholder until the Google Maps API is hooked up -->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="20dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Map of nearby dormitories"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_map" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_photo_scrim"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="Map markers coming soon (Google Maps)"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No dorms match your search"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Try a different keyword or clear your filters."
                android:textColor="@color/inkSoft"
                android:textSize="14sp" />

            <Button
                android:id="@+id/clearFiltersBtn"
                style="@style/Widget.DormMate.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Clear filters"
                android:textAllCaps="false" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
