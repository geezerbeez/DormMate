<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fitsSystemWindows="true">

    <!-- TOP HEADER (back, title, edit) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/backButtonIb"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@color/white"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/baseline_arrow_back_ios_new_24"
            app:shapeAppearanceOverlay="@style/circleImage"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/profileTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/editButtonIb"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@color/orange"
            android:contentDescription="Edit profile"
            android:padding="9dp"
            android:src="@drawable/baseline_edit_24"
            app:shapeAppearanceOverlay="@style/circleImage"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============ SCROLLABLE CONTENT ============ -->
    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@+id/topHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ===== Profile header (photo, name, progress) ===== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profileHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profilePicture"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/circleImage"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@drawable/catpfp" />

                <TextView
                    android:id="@+id/nameTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@android:color/black"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/profileProgressTv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/profilePicture"
                    app:layout_constraintTop_toTopOf="@+id/profilePicture"
                    app:layout_constraintVertical_chainStyle="packed"
                    tools:text="Maya Santos" />

                <TextView
                    android:id="@+id/profileProgressTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="#6B6B6B"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toTopOf="@+id/profileProgressBar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/profilePicture"
                    app:layout_constraintTop_toBottomOf="@+id/nameTv"
                    tools:text="Profile 85% complete" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/profileProgressBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"
                    app:indicatorColor="@color/orange"
                    app:trackColor="#E8E2D9"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/profilePicture"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/profilePicture"
                    app:layout_constraintTop_toBottomOf="@+id/profileProgressTv"
                    tools:progress="85" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ===== About you ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"

                android:text="About you"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"

                        android:text="GENDER"
                        android:textSize="11sp"/>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.DormMate.ValueCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/genderTv"
                            style="@style/ReadProfileValueText"
                            tools:text="Woman" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"

                        android:text="AGE"
                        android:textSize="11sp"/>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.DormMate.ValueCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/ageTv"
                            style="@style/ReadProfileValueText"
                            tools:text="20" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"

                        android:text="COURSE"
                        android:textSize="11sp"/>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.DormMate.ValueCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/courseTv"
                            style="@style/ReadProfileValueText"
                            android:drawablePadding="10dp"
                            android:drawableTint="#6B6B6B"
                            tools:text="BA Communication" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.4"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"

                        android:text="YEAR LEVEL"
                        android:textSize="11sp"/>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.DormMate.ValueCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/yearTv"
                            style="@style/ReadProfileValueText"
                            android:drawablePadding="10dp"
                            android:drawableTint="#6B6B6B"
                            tools:text="2nd year" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Housing preferences ===== -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="8dp"

                    android:text="Housing preferences"
                    android:textStyle="bold"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/budgetRangeTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:textColor="@color/orange"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="₱6,000–₱10,000" />
            </RelativeLayout>

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/budgetSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:focusable="false"
                android:stepSize="500"
                android:valueFrom="3000"
                android:valueTo="20000"
                app:thumbColor="@color/white"
                app:thumbHeight="22dp"
                app:thumbStrokeColor="@color/orange"
                app:thumbStrokeWidth="2dp"
                app:thumbWidth="22dp"
                app:tickVisible="false"
                app:trackColorActive="@color/orange"
                app:trackColorInactive="#E8E2D9"
                app:trackHeight="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"

                android:text="PREFERRED AREA"
                android:textSize="11sp"/>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DormMate.ValueCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/areaTv"
                    style="@style/ReadProfileValueText"
                    android:drawablePadding="10dp"
                    android:drawableStart="@drawable/baseline_location_on_24"
                    android:drawableTint="@color/orange"
                    tools:text="Katipunan · UP Diliman · Teacher's Village" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Lifestyle habits -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"

                android:text="Lifestyle Habits"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Drinking"
                    android:textColor="@android:color/black"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.DormMate.ValueCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/drinkingTv"
                            style="@style/ReadProfileValueText"
                            tools:text="Sometimes" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Smoking"
                    android:textColor="@android:color/black"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.DormMate.ValueCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/smokingTv"
                            style="@style/ReadProfileValueText"
                            tools:text="No" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Roommate preferences -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"

                android:text="Roommate Preference"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"

                android:text="GENDER"
                android:textSize="11sp"/>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DormMate.ValueCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1F2A30"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/roommateGenderTv"
                    style="@style/ReadProfileValueText"
                    android:layout_width="wrap_content"
                    android:minHeight="40dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="@color/white"
                    tools:text="Any gender" />
            </com.google.android.material.card.MaterialCardView>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"

                    android:text="AGE RANGE"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/roommateAgeTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:textColor="@color/orange"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="18–24" />
            </RelativeLayout>

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/roommateAgeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:focusable="false"
                android:stepSize="1"
                android:valueFrom="18"
                android:valueTo="60"
                app:thumbColor="@color/white"
                app:thumbHeight="22dp"
                app:thumbStrokeColor="@color/orange"
                app:thumbStrokeWidth="2dp"
                app:thumbWidth="22dp"
                app:tickVisible="false"
                app:trackColorActive="@color/orange"
                app:trackColorInactive="#E8E2D9"
                app:trackHeight="6dp" />

            <!-- Additional information  -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"

                android:text="Additional information"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DormMate.ValueCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/additionalInfoTv"
                    style="@style/ReadProfileValueText"
                    android:gravity="top|start"
                    android:minHeight="80dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:textSize="13sp"
                    tools:text="I value clear communication, shared chores, and a calm home for studying." />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>