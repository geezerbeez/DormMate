<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/bg_match_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IT'S A MATCH!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/orange"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="You found your potential roommate!"
        android:textSize="14sp"
        android:textColor="@color/darkGrey"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <ImageView
            android:id="@+id/myMatchImage"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground"
            app:shapeAppearanceOverlay="@style/circleImage"/>

        <ImageView
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginHorizontal="12dp"
            android:src="@drawable/ic_heart"
            app:tint="@color/orange"/>

        <ImageView
            android:id="@+id/otherMatchImage"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/circleImage"/>

    </LinearLayout>

    <TextView
        android:id="@+id/matchMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="You and Alex liked each other!"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/darkGrey"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueMatchBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Continue"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/orange"
            app:strokeColor="@color/orange"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="14dp"
            app:elevation="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/messageMatchBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Message"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/orange"
            app:cornerRadius="14dp"
            app:elevation="0dp"/>

    </LinearLayout>




</LinearLayout>